# ===========================================
# Sistema de Tickets Municipal - Variables de Entorno
# ===========================================
# Copie este archivo a .env y configure las variables

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_municipal
DB_USER=postgres
DB_PASS=postgres123

# ===========================================
# Azure AD / Microsoft 365 - OAuth2
# ===========================================
# Para obtener estas credenciales:
# 1. Ve a https://portal.azure.com
# 2. Azure Active Directory > Registros de aplicaciones > Nueva aplicación
# 3. Nombre: "Sistema Tickets Municipal"
# 4. Tipo: Web
# 5. URI de redirección: https://tu-dominio.cl/callback.php

AZURE_CLIENT_ID=tu-client-id-aqui
AZURE_CLIENT_SECRET=tu-client-secret-aqui
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_REDIRECT_URI=https://tu-dominio.cl/callback.php

# ===========================================
# Configuración de Email (SMTP)
# ===========================================
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@quintanormal.cl
MAIL_PASSWORD=tu-password
MAIL_FROM_ADDRESS=notificaciones@quintanormal.cl
MAIL_FROM_NAME="Mesa de Ayuda Municipal"
